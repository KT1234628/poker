{
  "name": "@stacks/game-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.3",
    "@stacks/poker-engine": "workspace:*",
    "@stacks/shared-types": "workspace:*",
    "@stacks/tournament-engine": "workspace:*",
    "@supabase/supabase-js": "^2.45.4",
    "ioredis": "^5.4.1",
    "jose": "^5.9.3",
    "livekit-server-sdk": "^2.7.2",
    "pino": "^9.4.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
