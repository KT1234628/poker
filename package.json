{
  "name": "stacks-poker",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:seed": "tsx scripts/seed.ts",
    "db:diff": "supabase db diff",
    "deploy:vercel": "vercel deploy --prod --cwd apps/web",
    "deploy:game": "cd apps/game-server && fly deploy",
    "deploy:solana": "cd apps/solana-program && anchor deploy --provider.cluster mainnet-beta",
    "format": "prettier --write \"**/*.{ts,tsx,md,sql,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,sql,json}\""
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/pg": "^8.20.0",
    "pg": "^8.20.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "supabase": "^1.207.0",
    "tsx": "^4.19.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2",
    "vercel": "^37.6.0"
  }
}
